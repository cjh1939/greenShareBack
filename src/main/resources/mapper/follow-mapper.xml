<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.green.greenshare.follow.mapper.FollowMapper">
    <!-- 쿼리 작성 -->

    <resultMap id="FollowWithUserMap" type="com.green.greenshare.follow.dto.FollowDTO">
        <id property="followId" column="FOLLOW_ID"/>
        <result property="fromUserEmail" column="FROM_USER_EMAIL"/>
        <result property="toUserEmail" column="TO_USER_EMAIL"/>
        <result property="followDate" column="FOLLOW_DATE"/>

        <association property="user" javaType="com.green.greenshare.user.dto.UserDTO">
            <id property="userEmail" column="USER_EMAIL"/>
            <result property="userName" column="USER_NAME"/>
            <result property="userTel" column="USER_TEL"/>
            <result property="userRole" column="USER_ROLE"/>
            <result property="joinDate" column="JOIN_DATE"/>
        </association>

    </resultMap>


    <!--   내가 팔로우한 목록 조회   -->
    <select id="selectFollowingList" resultMap="FollowWithUserMap">
        SELECT
        F.FOLLOW_ID, F.FROM_USER_EMAIL, F.TO_USER_EMAIL, F.FOLLOW_DATE,
        U.USER_EMAIL, U.USER_NAME, U.USER_TEL, U.USER_ROLE, U.JOIN_DATE
        FROM FOLLOW F
        JOIN USER U ON F.TO_USER_EMAIL = U.USER_EMAIL
        WHERE F.FROM_USER_EMAIL = #{fromUserEmail}
    </select>

    <!--  팔로우 등록 쿼리  -->
    <insert id="insertFollow">
        INSERT INTO FOLLOW (FROM_USER_EMAIL, TO_USER_EMAIL)
        VALUES (#{fromUserEmail}, #{toUserEmail})
    </insert>

    <!-- 팔로우 취소 쿼리   -->
    <delete id="unfollow">
        DELETE FROM FOLLOW
        WHERE FROM_USER_EMAIL = #{fromUserEmail}
        AND TO_USER_EMAIL = #{toUserEmail}
    </delete>






</mapper>